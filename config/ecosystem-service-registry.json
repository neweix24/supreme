{
  "schema_version": "1.0.0",
  "registry_authority": "neweix24/supreme",
  "governance_document": "GOVERNANCE.md",
  "last_reviewed": "2026-11-27",
  "hierarchy": {
    "highest_authority": "supreme",
    "central_operations": "admin",
    "service_operators": "service-scoped identities",
    "rule": "Admin operates all routine ecosystem activities under Supreme-approved scoped grants; Admin cannot override Supreme."
  },
  "global_invariants": {
    "customer_identity_owner": "account",
    "financial_ledger_owner": "eixon",
    "public_service_directory_owner": "neweix",
    "supreme_only_controls": [
      "global_policy_changes",
      "service_registry_changes",
      "admin_top_level_grants",
      "production_high_risk_activation",
      "exceptional_financial_adjustments",
      "root_security_and_ownership_changes",
      "break_glass_access"
    ],
    "admin_scope": "routine_operations_across_services_with_explicit_scoped_grants",
    "eix_policy": {
      "purpose": "Neweix products and services only",
      "classification": "Neweix ecosystem purchase token; not a virtual currency, virtual asset or external transaction medium",
      "acquisition": "approved direct online payment methods; no Eixon merchant network",
      "ordinary_p2p": false,
      "wallet_to_wallet_transfer": false,
      "designated_gift_flow_only": true,
      "max_gift_limit_bdt": 1000,
      "owner": "eixon"
    },
    "checkout_fail_closed_until": [
      "Account OIDC/PKCE client contract",
      "Eixon payment intent and confirmation contract",
      "idempotency and webhook verification",
      "refund and reconciliation contract",
      "Supreme-approved Admin grant",
      "order audit and cancellation policy",
      "inventory reservation and release",
      "verified delivery and fulfilment integration"
    ]
  },
  "services": [
    {
      "id": "supreme",
      "name": "Supreme",
      "repository": "neweix24/supreme",
      "responsibility": "ecosystem authority, governance, security approvals, Admin grants, registry and audit",
      "status": "active_control_plane",
      "owns": [
        "global_policy",
        "admin_grants",
        "service_registry",
        "privileged_approvals",
        "governance_audit"
      ],
      "must_not_own": [
        "customer_identity",
        "shop_catalog",
        "service_business_data",
        "eixon_ledger"
      ]
    },
    {
      "id": "neweix",
      "name": "Neweix",
      "repository": "neweix24/neweix",
      "responsibility": "public website, service directory and ecosystem entry point",
      "status": "deployed_portal",
      "owns": [
        "public_website",
        "service_directory_presentation"
      ],
      "must_not_own": [
        "customer_authentication",
        "financial_ledger",
        "other_service_business_data"
      ]
    },
    {
      "id": "account",
      "name": "Neweix Account",
      "repository": "neweix24/account",
      "responsibility": "customer identity, authentication, Account ID, usernames, profiles and sessions",
      "status": "implementation_present_deployment_blocked",
      "owns": [
        "customer_identity",
        "authentication",
        "profiles",
        "customer_sessions"
      ],
      "must_not_own": [
        "admin_supreme_authority",
        "eixon_ledger",
        "shop_orders"
      ]
    },
    {
      "id": "eixon",
      "name": "Eixon",
      "repository": "neweix24/eixon",
      "responsibility": "EIX wallet, balance, journal and financial operations under approved EIX policy",
      "status": "architecture_reconciliation_required",
      "owns": [
        "eix_wallet",
        "balances",
        "ledger",
        "payment_records"
      ],
      "must_not_own": [
        "customer_identity_source",
        "shop_orders",
        "subscription_entitlements"
      ]
    },
    {
      "id": "shop",
      "name": "Neweix Shop",
      "repository": "neweix24/shop",
      "responsibility": "catalog, inventory, cart, orders, customer order experience and fulfilment",
      "status": "storefront_deployed_api_and_checkout_disabled",
      "owns": [
        "catalog",
        "inventory",
        "orders",
        "fulfilment"
      ],
      "must_not_own": [
        "customer_identity_source",
        "eix_balance",
        "financial_ledger"
      ]
    },
    {
      "id": "connect",
      "name": "Neweix Connect",
      "repository": "neweix24/connect",
      "responsibility": "messaging, conversations, messages and attachments",
      "status": "mvp_foundation_security_and_integration_incomplete",
      "owns": [
        "conversations",
        "messages",
        "attachments"
      ],
      "must_not_own": [
        "customer_identity_source",
        "global_admin_grants"
      ]
    },
    {
      "id": "neweix-plus",
      "name": "Neweix+",
      "repository": "neweix24/neweix-plus",
      "responsibility": "subscription plans, membership lifecycle and entitlements",
      "status": "planned",
      "owns": [
        "plans",
        "subscriptions",
        "entitlements"
      ],
      "must_not_own": [
        "eix_balance",
        "financial_ledger",
        "customer_identity_source"
      ]
    },
    {
      "id": "eixora",
      "name": "Eixora",
      "repository": "neweix24/eixora",
      "responsibility": "social profiles, posts, feeds and interactions",
      "status": "planned",
      "owns": [
        "social_content",
        "feeds",
        "social_interactions"
      ],
      "must_not_own": [
        "customer_identity_source",
        "global_admin_grants"
      ]
    },
    {
      "id": "employees",
      "name": "Neweix Employees",
      "repository": "neweix24/employees",
      "responsibility": "workforce records and operational role assignment",
      "status": "planned",
      "owns": [
        "workforce_records",
        "operational_role_assignments"
      ],
      "must_not_own": [
        "supreme_authority",
        "customer_identity_source",
        "financial_ledger"
      ]
    }
  ],
  "integration_contracts": [
    {
      "from": "all_services",
      "to": "supreme",
      "purpose": "policy, service registration, privileged approval and scoped Admin grants",
      "mode": "signed_control_plane_contract",
      "status": "contract_to_implement_and_test"
    },
    {
      "from": "all_customer_services",
      "to": "account",
      "purpose": "customer identity and authentication",
      "mode": "OIDC/OAuth2 Authorization Code + PKCE; service-specific audience and scopes",
      "status": "contract_to_implement_and_test"
    },
    {
      "from": "shop",
      "to": "eixon",
      "purpose": "purchase payment, confirmation, refund and reconciliation",
      "mode": "signed payment intent API + verified webhooks + idempotency",
      "status": "not_implemented_checkout_disabled"
    },
    {
      "from": "neweix-plus",
      "to": "eixon",
      "purpose": "subscription payment and renewal",
      "mode": "signed payment intent API + verified webhooks + idempotency",
      "status": "not_implemented"
    },
    {
      "from": "employees",
      "to": "supreme",
      "purpose": "workforce identity may request scoped Admin grants",
      "mode": "approval workflow; no self-grant",
      "status": "planned"
    }
  ],
  "repository_policy": {
    "canonical_governance_repo": "neweix24/supreme",
    "canonical_registry_path": "config/ecosystem-service-registry.json",
    "service_repositories_must_link_to_canonical_docs": true,
    "duplicated_global_blueprints_are_non_authoritative": true,
    "production_changes_require_review_and_release_gates": true
  }
}
